# Copy this file to .env and fill in your keys:  cp .env.example .env

# Model provider (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Web search (https://app.tavily.com)
TAVILY_API_KEY=

# Tracing (https://smith.langchain.com -> Settings -> API Keys)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=deepagents-research-agent
